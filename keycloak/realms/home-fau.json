{
  "realm": "home-fau",
  "enabled": true,
  "components": {
    "org.keycloak.keys.KeyProvider": [
      {
        "name": "home-fau-saml-signing",
        "providerId": "rsa",
        "subComponents": {},
        "config": {
          "priority": ["200"],
          "enabled": ["true"],
          "active": ["true"],
          "algorithm": ["RS256"],
          "privateKey": ["$(env:HOME_FAU_SAML_PRIVATE_KEY)"],
          "certificate": ["$(env:HOME_FAU_SAML_CERT)"]
        }
      },
      {
        "name": "rsa-generated",
        "providerId": "rsa-generated",
        "subComponents": {},
        "config": {
          "enabled": ["false"]
        }
      }
    ]
  }
}
