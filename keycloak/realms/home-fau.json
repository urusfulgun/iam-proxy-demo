{
  "realm": "home-fau",
  "enabled": true,
  "attributes": { "userProfileEnabled": "true" },
  "components": {
    "org.keycloak.keys.KeyProvider": [
      {
        "name": "home-fau-saml-signing",
        "providerId": "rsa",
        "subComponents": {},
        "config": {
          "priority": ["200"],
          "enabled": ["true"],
          "active": ["true"],
          "algorithm": ["RS256"],
          "privateKey": ["$(env:HOME_FAU_SAML_PRIVATE_KEY)"],
          "certificate": ["$(env:HOME_FAU_SAML_CERT)"]
        }
      },
      {
        "name": "rsa-generated",
        "providerId": "rsa-generated",
        "subComponents": {},
        "config": {
          "enabled": ["false"]
        }
      }
    ]
  },
  "userProfile": {
    "attributes": [
      {
        "name": "username",
        "displayName": "${username}",
        "validations": {
          "length": { "min": 3, "max": 255 },
          "username-prohibited-characters": {},
          "up-username-not-idn-homograph": {}
        },
        "permissions": { "view": ["admin", "user"], "edit": ["admin", "user"] },
        "multivalued": false
      },
      {
        "name": "email",
        "displayName": "${email}",
        "validations": { "email": {}, "length": { "max": 255 } },
        "required": { "roles": ["user"] },
        "permissions": { "view": ["admin", "user"], "edit": ["admin", "user"] },
        "multivalued": false
      },
      {
        "name": "firstName",
        "displayName": "${firstName}",
        "validations": { "length": { "max": 255 }, "person-name-prohibited-characters": {} },
        "required": { "roles": ["user"] },
        "permissions": { "view": ["admin", "user"], "edit": ["admin", "user"] },
        "multivalued": false
      },
      {
        "name": "lastName",
        "displayName": "${lastName}",
        "validations": { "length": { "max": 255 }, "person-name-prohibited-characters": {} },
        "required": { "roles": ["user"] },
        "permissions": { "view": ["admin", "user"], "edit": ["admin", "user"] },
        "multivalued": false
      },
      {
        "name": "eduPersonPrincipalName",
        "displayName": "eduPersonPrincipalName",
        "validations": {
          "pattern": { "pattern": "^[^@\\s]+@fau\\.de$", "error-message": "must be <user>@fau.de" }
        },
        "permissions": { "view": ["admin"], "edit": ["admin"] },
        "multivalued": false
      },
      {
        "name": "eduPersonScopedAffiliation",
        "displayName": "eduPersonScopedAffiliation",
        "validations": {
          "pattern": {
            "pattern": "^(member|student|staff|faculty|employee|affiliate)@fau\\.de$",
            "error-message": "must be <affiliation>@fau.de"
          }
        },
        "permissions": { "view": ["admin"], "edit": ["admin"] },
        "multivalued": true
      },
      {
        "name": "schacHomeOrganization",
        "displayName": "schacHomeOrganization",
        "validations": {
          "pattern": { "pattern": "^fau\\.de$", "error-message": "must be fau.de" }
        },
        "permissions": { "view": ["admin"], "edit": ["admin"] },
        "multivalued": false
      }
    ],
    "groups": [
      {
        "name": "user-metadata",
        "displayHeader": "User metadata",
        "displayDescription": "Attributes, which refer to user metadata"
      }
    ]
  },
  "clients": [
    {
      "clientId": "http://auth.localhost:8080/realms/aloysius",
      "name": "aloysius broker",
      "protocol": "saml",
      "enabled": true,
      "frontchannelLogout": false,
      "fullScopeAllowed": false,
      "redirectUris": ["http://auth.localhost:8080/realms/aloysius/broker/home-fau/endpoint"],
      "defaultClientScopes": [],
      "optionalClientScopes": [],
      "attributes": {
        "saml_assertion_consumer_url_post": "http://auth.localhost:8080/realms/aloysius/broker/home-fau/endpoint",
        "saml.force.post.binding": "true",
        "saml.server.signature": "true",
        "saml.assertion.signature": "true",
        "saml.signature.algorithm": "RSA_SHA256",
        "saml_signature_canonicalization_method": "http://www.w3.org/2001/10/xml-exc-c14n#",
        "saml.server.signature.keyinfo.ext": "false",
        "saml.client.signature": "false",
        "saml.encrypt": "false",
        "saml.authnstatement": "true",
        "saml_name_id_format": "persistent",
        "saml_force_name_id_format": "true"
      },
      "protocolMappers": [
        {
          "name": "eduPersonPrincipalName",
          "protocol": "saml",
          "protocolMapper": "saml-user-attribute-mapper",
          "config": {
            "user.attribute": "eduPersonPrincipalName",
            "attribute.name": "urn:oid:1.3.6.1.4.1.5923.1.1.1.6",
            "attribute.nameformat": "URI Reference",
            "friendly.name": "eduPersonPrincipalName",
            "aggregate.attrs": "false"
          }
        },
        {
          "name": "eduPersonScopedAffiliation",
          "protocol": "saml",
          "protocolMapper": "saml-user-attribute-mapper",
          "config": {
            "user.attribute": "eduPersonScopedAffiliation",
            "attribute.name": "urn:oid:1.3.6.1.4.1.5923.1.1.1.9",
            "attribute.nameformat": "URI Reference",
            "friendly.name": "eduPersonScopedAffiliation",
            "aggregate.attrs": "true"
          }
        },
        {
          "name": "schacHomeOrganization",
          "protocol": "saml",
          "protocolMapper": "saml-user-attribute-mapper",
          "config": {
            "user.attribute": "schacHomeOrganization",
            "attribute.name": "urn:oid:1.3.6.1.4.1.25178.1.2.9",
            "attribute.nameformat": "URI Reference",
            "friendly.name": "schacHomeOrganization",
            "aggregate.attrs": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "alice",
      "email": "alice@fau.de",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Example",
      "enabled": true,
      "requiredActions": [],
      "attributes": {
        "eduPersonPrincipalName": ["alice@fau.de"],
        "eduPersonScopedAffiliation": ["member@fau.de", "staff@fau.de"],
        "schacHomeOrganization": ["fau.de"]
      },
      "credentials": [
        { "type": "password", "value": "$(env:DEMO_USER_PASSWORD)", "temporary": false }
      ]
    }
  ]
}
