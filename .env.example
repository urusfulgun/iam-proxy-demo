# Copied to .env by `make init`, which fills the empty secrets with `openssl rand -hex 24`.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=
POSTGRES_PASSWORD=
# SAML signing keypairs of the home realms: base64 PKCS#8 key and X.509 cert, one line each,
# no PEM header. `make keys` (run by `make init`) fills any pair that is empty or missing.
HOME_FAU_SAML_PRIVATE_KEY=
HOME_FAU_SAML_CERT=
HOME_BAMBERG_SAML_PRIVATE_KEY=
HOME_BAMBERG_SAML_CERT=
